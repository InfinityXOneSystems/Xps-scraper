# ─── XPS Shadow Scraper – Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# All variables with defaults are optional.
# Variables without defaults are REQUIRED for full functionality.

# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND
# ═══════════════════════════════════════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=development                      # development | production | test
FRONTEND_URL=http://localhost:3000        # CORS allow-origin

# ─── Authentication ────────────────────────────────────────────────────────────
# Leave both empty to disable auth in development.
# In production, set at least one of these.
API_KEY=                                  # Static API key (X-API-Key header or Bearer token)
JWT_SECRET=                               # Secret for signing JWTs

# ─── LLM / AI Configuration ───────────────────────────────────────────────────
# OpenAI-compatible API (works with OpenAI, Ollama, LM Studio, Groq, etc.)
LLM_API_URL=http://localhost:11434/v1     # Ollama default; use https://api.openai.com/v1 for OpenAI
LLM_API_KEY=ollama                        # 'ollama' for local; your OpenAI key for cloud
LLM_MODEL=llama3.2                        # Model name (llama3.2, gpt-4o-mini, mistral, etc.)

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000               # 15 minutes in milliseconds
RATE_LIMIT_MAX=100                        # Max requests per window

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:3001/api    # Backend API URL (set to Railway URL in prod)
VITE_APP_TITLE="XPS Shadow Scraper"       # App title

# ═══════════════════════════════════════════════════════════════════════════════
# RAILWAY DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Set these in Railway's dashboard or via railway CLI:
#   railway variables set RAILWAY_TOKEN=<your-token>
RAILWAY_TOKEN=                            # Railway API token for CI/CD deploys

# ─── Railway Service URLs (auto-set by Railway, copy to other services) ────────
# After first deploy, Railway assigns these URLs automatically.
# RAILWAY_STATIC_URL=https://your-frontend.up.railway.app
# BACKEND_URL=https://your-backend.up.railway.app

# ═══════════════════════════════════════════════════════════════════════════════
# XPS INTELLIGENCE SYSTEM SYNC
# (auto-populated by GitHub Actions env-sync workflow)
# ═══════════════════════════════════════════════════════════════════════════════

# XPS Intelligence System repo secrets are synced via .github/workflows/sync-env.yml
# Set these in the GitHub repo's Secrets & Variables to enable auto-sync:
#   XPS_INTELLIGENCE_API_URL    – base URL of xps-intelligence-system backend
#   XPS_INTELLIGENCE_API_KEY    – API key for xps-intelligence-system
#   XPS_LEAD_INTELLIGENCE_URL   – base URL of xps-lead-intelligence backend
#   XPS_LEAD_INTELLIGENCE_KEY   – API key for xps-lead-intelligence
#   XPS_FRONTEND_URL            – URL of xps-intelligence-frontend

XPS_INTELLIGENCE_API_URL=
XPS_INTELLIGENCE_API_KEY=
XPS_LEAD_INTELLIGENCE_URL=
XPS_LEAD_INTELLIGENCE_KEY=
XPS_FRONTEND_URL=
