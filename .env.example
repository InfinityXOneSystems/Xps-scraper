# ─── XPS Shadow Scraper – Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# All variables with defaults are optional.
# Variables without defaults are REQUIRED for full functionality.

# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND
# ═══════════════════════════════════════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=development                      # development | production | test
FRONTEND_URL=http://localhost:3000        # CORS allow-origin

# ─── Authentication ────────────────────────────────────────────────────────────
# Leave both empty to disable auth in development.
# In production, set at least one of these.
API_KEY=                                  # Static API key (X-API-Key header or Bearer token)
JWT_SECRET=                               # Secret for signing JWTs

# ─── LLM / AI Configuration ───────────────────────────────────────────────────
# OpenAI-compatible API (works with OpenAI, Ollama, LM Studio, Groq, etc.)
LLM_API_URL=http://localhost:11434/v1     # Ollama default; use https://api.openai.com/v1 for OpenAI
LLM_API_KEY=ollama                        # 'ollama' for local; your OpenAI key for cloud
LLM_MODEL=llama3.2                        # Model name (llama3.2, gpt-4o-mini, mistral, etc.)

# ─── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=                             # Groq API key (gsk_…)
GROQ_MODEL=llama-3.3-70b-versatile        # Groq model to use

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000               # 15 minutes in milliseconds
RATE_LIMIT_MAX=100                        # Max requests per window

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:3001/api    # Backend API URL (set to Railway URL in prod)
VITE_APP_TITLE="XPS Shadow Scraper"       # App title

# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE
# ═══════════════════════════════════════════════════════════════════════════════

SUPABASE_URL=                             # https://xxx.supabase.co
SUPABASE_ANON_KEY=                        # eyJhbGci… (public anon key)

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

DATABASE_URL=                             # postgresql://user:pass@host:5432/db (Railway Postgres)
REDIS_URL=                                # redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════════
# GITHUB OAUTH
# ═══════════════════════════════════════════════════════════════════════════════

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════════════════════════════

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# RAILWAY DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Set these in Railway's dashboard or via railway CLI:
#   railway variables set RAILWAY_TOKEN=<your-token>
RAILWAY_TOKEN=                            # Railway API token for CI/CD deploys

# ─── Railway Service URLs (auto-set by Railway, copy to other services) ────────
# After first deploy, Railway assigns these URLs automatically.
# RAILWAY_STATIC_URL=https://your-frontend.up.railway.app
# BACKEND_URL=https://your-backend.up.railway.app

# ═══════════════════════════════════════════════════════════════════════════════
# XPS INTELLIGENCE SYSTEM SYNC
# (auto-populated by GitHub Actions env-sync workflow)
# ═══════════════════════════════════════════════════════════════════════════════

# XPS Intelligence System repo secrets are synced via .github/workflows/sync-env.yml
# Set these in the GitHub repo's Secrets & Variables to enable auto-sync:
#   XPS_INTELLIGENCE_API_URL    – base URL of xps-intelligence-system backend
#   XPS_INTELLIGENCE_API_KEY    – API key for xps-intelligence-system
#   XPS_LEAD_INTELLIGENCE_URL   – base URL of xps-lead-intelligence backend
#   XPS_LEAD_INTELLIGENCE_KEY   – API key for xps-lead-intelligence
#   XPS_FRONTEND_URL            – URL of xps-intelligence-frontend

XPS_INTELLIGENCE_API_URL=
XPS_INTELLIGENCE_API_KEY=
XPS_LEAD_INTELLIGENCE_URL=
XPS_LEAD_INTELLIGENCE_KEY=
XPS_FRONTEND_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# GROQ AI
# ═══════════════════════════════════════════════════════════════════════════════

GROQ_API_KEY=                             # Groq API key (https://console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile        # Groq model (llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it)

# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE
# ═══════════════════════════════════════════════════════════════════════════════

SUPABASE_URL=                             # https://your-project.supabase.co
SUPABASE_ANON_KEY=                        # Supabase anonymous key

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE (Railway Postgres + Redis)
# ═══════════════════════════════════════════════════════════════════════════════

DATABASE_URL=                             # postgres://user:pass@host:5432/db
REDIS_URL=                                # redis://default:pass@host:6379

# ═══════════════════════════════════════════════════════════════════════════════
# OAUTH PROVIDERS
# ═══════════════════════════════════════════════════════════════════════════════

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# GITHUB PAGES
# ═══════════════════════════════════════════════════════════════════════════════

VITE_BASE_PATH=./                         # Base path for GitHub Pages (e.g. '/Xps-scraper/' for a project page)

# ═══════════════════════════════════════════════════════════════════════════════
# TWILIO SMS
# ═══════════════════════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=                       # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=                        # your_auth_token
TWILIO_PHONE_NUMBER=                      # +1XXXXXXXXXX (your Twilio number)

# ═══════════════════════════════════════════════════════════════════════════════
# STRIPE PAYMENTS
# ═══════════════════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=                        # sk_live_xxx or sk_test_xxx
STRIPE_PUBLISHABLE_KEY=                   # pk_live_xxx or pk_test_xxx
STRIPE_WEBHOOK_SECRET=                    # whsec_xxx (from Stripe dashboard)
VITE_STRIPE_PUBLISHABLE_KEY=              # same as STRIPE_PUBLISHABLE_KEY (frontend)

# ═══════════════════════════════════════════════════════════════════════════════
# SQUARE PAYMENTS
# ═══════════════════════════════════════════════════════════════════════════════
SQUARE_ACCESS_TOKEN=                      # your Square access token
SQUARE_APPLICATION_ID=                   # your Square application ID
SQUARE_LOCATION_ID=                       # your Square location ID
SQUARE_ENVIRONMENT=sandbox                # sandbox | production
VITE_SQUARE_APPLICATION_ID=              # same as SQUARE_APPLICATION_ID (frontend)

# ═══════════════════════════════════════════════════════════════════════════════
# HUBSPOT CRM
# ═══════════════════════════════════════════════════════════════════════════════
HUBSPOT_ACCESS_TOKEN=                     # pat-na1-xxx (private app token)
HUBSPOT_PORTAL_ID=                        # your HubSpot portal/hub ID
VITE_HUBSPOT_PORTAL_ID=                   # same as HUBSPOT_PORTAL_ID (frontend)

# ═══════════════════════════════════════════════════════════════════════════════
# XTREME AI SYSTEM SYNC
# ═══════════════════════════════════════════════════════════════════════════════
XTREME_AI_API_URL=                        # base URL of xtreme-ai backend
XTREME_AI_API_KEY=                        # API key for xtreme-ai

# ═══════════════════════════════════════════════════════════════════════════════
# XPS INTELLIGENCE SYSTEM (additional fields)
# ═══════════════════════════════════════════════════════════════════════════════
XPS_INTELLIGENCE_WEBHOOK_SECRET=          # shared secret for webhook verification

# ═══════════════════════════════════════════════════════════════════════════════
# GITHUB APP (XPS Orchestrator)
# ═══════════════════════════════════════════════════════════════════════════════
GITHUB_APP_ID=                            # GitHub App numeric ID
GITHUB_APP_PRIVATE_KEY=                   # PEM private key (replace newlines with \n)
GITHUB_APP_INSTALLATION_ID=              # installation ID for your account
GITHUB_WEBHOOK_SECRET=                    # webhook secret for GitHub App events
VITE_GITHUB_APP_NAME=xps-orchestrator    # GitHub App slug name

# ═══════════════════════════════════════════════════════════════════════════════
# FIRECRAWL (https://firecrawl.dev)
# ═══════════════════════════════════════════════════════════════════════════════
FIRECRAWL_API_KEY=                        # fc-xxx (get from https://app.firecrawl.dev)

# ═══════════════════════════════════════════════════════════════════════════════
# STEEL BROWSER (https://steel.dev)
# ═══════════════════════════════════════════════════════════════════════════════
STEEL_API_KEY=                            # steel-xxx (get from https://app.steel.dev)

# ═══════════════════════════════════════════════════════════════════════════════
# BYTEBOT (https://bytebot.ai / self-hosted)
# ═══════════════════════════════════════════════════════════════════════════════
BYTEBOT_URL=http://localhost:7080         # Bytebot service URL (docker: http://bytebot:7080)
BYTEBOT_API_KEY=                          # API key if Bytebot auth is enabled

# ═══════════════════════════════════════════════════════════════════════════════
# N8N WORKFLOW AUTOMATION (https://n8n.io / self-hosted)
# ═══════════════════════════════════════════════════════════════════════════════
N8N_URL=http://localhost:5678             # n8n service URL (docker: http://n8n:5678)
N8N_API_KEY=                             # n8n API key (Settings → API in n8n UI)

# ═══════════════════════════════════════════════════════════════════════════════
# POSTGRES LOCAL (docker-compose dev only — Railway injects DATABASE_URL)
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=xps
POSTGRES_PASSWORD=xpspassword
POSTGRES_DB=xps_scraper
VERCEL_TOKEN=                             # Vercel personal access token
RAILWAY_API_TOKEN=                        # Railway API token (v2)
NETLIFY_TOKEN=                            # Netlify personal access token
OPENAI_API_KEY=                           # OpenAI API key (sk-xxx)
ANTHROPIC_API_KEY=                        # Anthropic Claude API key

# ═══════════════════════════════════════════════════════════════════════════════
# FULL-STACK INTEGRATION — Template Service URLs
# (auto-configured after running: bash scripts/setup-integration.sh)
# ═══════════════════════════════════════════════════════════════════════════════

# Open Claw (asset extraction/enrichment — templates/open-claw)
OPEN_CLAW_URL=http://localhost:3003       # docker-compose: http://open-claw:3003
OPEN_CLAW_API_KEY=                        # optional auth key for Open Claw

# Open Deep Research (LLM fact extraction — templates/open-deep-research)
DEEP_RESEARCH_URL=http://localhost:3004   # docker-compose: http://open-deep-research:3004
DEEP_RESEARCH_API_KEY=                    # optional auth key for Deep Research

# Firecrawl MCP Server (MCP agent mesh — templates/firecrawl-mcp)
FIRECRAWL_MCP_URL=http://localhost:3002   # MCP server URL

# Open Lovable / Agent Builder UI
# Set VITE_AGENT_BUILDER_URL if running open-agent-builder separately
VITE_AGENT_BUILDER_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# OLLAMA (local LLM — optional, used if LLM_API_URL points to Ollama)
# ═══════════════════════════════════════════════════════════════════════════════
OLLAMA_HOST=http://localhost:11434        # Ollama API host
OLLAMA_MODEL=llama3.2                     # Default model to pull on startup

# ─── To switch from Groq to Ollama, set: ─────────────────────────────────────
# LLM_API_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ═══════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE — n8n Auth
# ═══════════════════════════════════════════════════════════════════════════════
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8npassword
